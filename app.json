{
  "expo": {
    "name": "My Fleet",
    "slug": "my-fleet-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "myfleet",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.progix.myfleet-client",
      "buildNumber": "8",
      "icon": "./assets/logo.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Autorisez My Fleet à utiliser votre position pour afficher le point de prise en charge et l'itinéraire sur la carte.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "217.65.144.155": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.progix.myfleet.client",
      "versionCode": 5,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "myfleet"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Autorisez My Fleet à accéder à l'appareil photo pour scanner le QR code de l'agence."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez My Fleet à accéder à vos photos pour envoyer vos documents d'identité.",
          "cameraPermission": "Autorisez My Fleet à accéder à l'appareil photo pour photographier vos documents d'identité."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autorisez My Fleet à utiliser votre position pour afficher le point de prise en charge et l'itinéraire sur la carte."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfa4e46d-bc54-4728-82af-7a949aaf42c9"
      }
    },
    "owner": "iheb1"
  }
}